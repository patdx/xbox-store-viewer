{
	"name": "xbox-store-viewer",
	"private": true,
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"build": "wrangler types && react-router build",
		"deploy": "wrangler deploy",
		"dev": "react-router dev",
		"start": "wrangler dev",
		"typecheck": "tsc",
		"typegen": "wrangler types",
		"update-react": "pnpm install --save-exact react@rc react-dom@rc",
		"format": "prettier --write .",
		"scn:add": "pnpx shadcn-ui@latest add"
	},
	"dependencies": {
		"@radix-ui/react-slot": "1.5.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"isbot": "5.2.2",
		"lodash-es": "4.18.1",
		"lucide-react": "0.577.0",
		"ofetch": "1.5.1",
		"react": "rc",
		"react-dom": "rc",
		"react-error-boundary": "6.1.6",
		"react-router": "^7.7.1",
		"tailwind-merge": "3.7.0",
		"tailwindcss-animate": "1.0.7",
		"valibot": "1.5.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.10.2",
		"@cloudflare/workers-types": "4.20250726.0",
		"@react-router/dev": "^7.7.1",
		"@react-router/fs-routes": "7.18.5",
		"@tailwindcss/postcss": "4.3.3",
		"@tailwindcss/vite": "4.3.3",
		"@types/lodash-es": "4.17.12",
		"@types/react": "npm:types-react@rc",
		"@types/react-dom": "npm:types-react-dom@rc",
		"postcss": "8.5.32",
		"prettier": "3.9.10",
		"prettier-plugin-tailwindcss": "0.8.1",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3",
		"unplugin-auto-import": "19.3.0",
		"vite": "7.3.7",
		"vite-tsconfig-paths": "5.1.4",
		"wrangler": "4.26.1"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"better-sqlite3"
		],
		"overrides": {
			"@types/react": "$@types/react",
			"@types/react-dom": "$@types/react-dom"
		}
	},
	"packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32"
}
